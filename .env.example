# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# The optional ML subsystem (server/prediction.py, server/training.py) is the
# only thing that needs a database. The scanner and dashboard run without one.

# --- MongoDB ---
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=SmartTraid
DB_USER=smartraid
DB_PASSWORD=change-me-to-something-long-and-random
DB_AUTH_SOURCE=admin

# --- Model integrity ---
# Signs stored models with HMAC-SHA256. Without it, a model blob fetched from the
# database is deserialised on trust, and deserialising is code execution.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
MODEL_STORE_KEY=

# --- Optional: currency conversion (scraping.get_exchange_rate) ---
EXCHANGE_API_KEY=

# --- Monitor station HTTP Basic Auth (server/web/auth.py) ---
# Both must be set to turn auth on. Required before binding the monitor
# station to anything other than 127.0.0.1 — see server/run.py's warning.
# Not read from .env automatically by run.py; export them in your shell or
# pass -e to `docker run` (see the Dockerfile).
SMARTRAID_USER=
SMARTRAID_PASSWORD=
